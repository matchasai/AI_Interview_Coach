# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-chars
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# AI provider (Groq)
# Get a Groq API key and keep it SECRET (do not put this in frontend/.env)
AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-groq-api-key
GROQ_MODEL=llama-3.1-70b-versatile
GROQ_TEMPERATURE=0.7

# When false, backend falls back to local questions/evaluation if Groq fails
AI_STRICT_MODE=false
